  {
   "type": "table",
   "title": "1. Storage Status",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "fe7df75wpzldsb"
   },
   "description": "Replaces the 'Storage Status' table of the Manual Daily Health Check email",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "storage_info{site=~\"$site\",target=~\"$target\"}",
     "refId": "A",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "max by (target) (storage_up{site=~\"$site\",target=~\"$target\"})",
     "refId": "B",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "max by (target) (storage_system_health{site=~\"$site\",target=~\"$target\"})",
     "refId": "C",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "sum by (target) (storage_alerts_active{site=~\"$site\",target=~\"$target\",severity=~\"critical|warning\"})",
     "refId": "D",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "max by (target) (100 * (1 - storage_pool_free_bytes{site=~\"$site\",target=~\"$target\"} / storage_pool_size_bytes{site=~\"$site\",target=~\"$target\"}))",
     "refId": "E",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "count by (target) (storage_component_health{site=~\"$site\",target=~\"$target\"} > 0 and storage_component_health{site=~\"$site\",target=~\"$target\"} < 3) or sum by (target) (storage_up{site=~\"$site\",target=~\"$target\"} * 0)",
     "refId": "F",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "fe7df75wpzldsb"
     },
     "expr": "count by (target) (storage_host_health{site=~\"$site\",target=~\"$target\"} > 0) or sum by (target) (storage_up{site=~\"$site\",target=~\"$target\"} * 0)",
     "refId": "G",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "Value #A": true,
       "instance": true,
       "job": true,
       "serial": true,
       "vendor": true
      },
      "indexByName": {
       "target": 0,
       "site": 1,
       "ip": 2,
       "model": 3,
       "version": 4,
       "name": 5,
       "Value #B": 6,
       "Value #C": 7,
       "Value #D": 8,
       "Value #F": 9,
       "Value #G": 10,
       "Value #E": 11
      },
      "renameByName": {
       "target": "Hostname",
       "site": "Site",
       "ip": "IP",
       "model": "Model",
       "version": "Firmware",
       "name": "Device name",
       "Value #B": "Connection",
       "Value #C": "System Health",
       "Value #D": "Active alert",
       "Value #E": "Max pool usage",
       "Value #F": "Faulty components",
       "Value #G": "Host warning"
      }
     }
